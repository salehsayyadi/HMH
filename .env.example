# HMH Production Environment Template
PROJECT_NAME=HMH
APP_ENV=production
TIMEZONE=Asia/Tehran
LOG_LEVEL=INFO

# Server & Network Configuration
SERVER_OS=Ubuntu 24.04 LTS
DOMAIN=salehvip-clud.ir
SUBDOMAIN=reserve.salehvip-clud.ir
API_BASE_URL=https://reserve.salehvip-clud.ir/api/v1
WEBSOCKET_URL=wss://reserve.salehvip-clud.ir/ws
HTTP_PORT=80
HTTPS_PORT=443

# MySQL 9.7 LTS Database Configuration
DATABASE_ENGINE=mysql
MYSQL_VERSION=9.7-LTS
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=amphitheater_db
MYSQL_USER=amphitheater_app
MYSQL_PASSWORD=change_this_to_a_secure_random_password
MYSQL_ROOT_PASSWORD=change_this_to_a_secure_root_password
MYSQL_CHARSET=utf8mb4
MYSQL_COLLATION=utf8mb4_unicode_ci

# JWT Security Configuration
JWT_SECRET_KEY=generate_a_random_64_character_hex_secret_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Initial Bootstrap Super Administrator
# Note: First login forces immediate password change. Bootstrap disables after first initialization.
INITIAL_ADMIN_USERNAME=123IMHModirkol@1090
INITIAL_ADMIN_PASSWORD=123IMHModirkol@1090

# CORS Allowed Origins (Comma separated)
CORS_ORIGINS=https://reserve.salehvip-clud.ir,http://localhost:3000,http://localhost:5173,http://localhost:8000
